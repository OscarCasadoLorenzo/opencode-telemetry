      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (model) (increase(opencode_tokens_total{token_type=~\"input|output\"}[$__range]))", "legendFormat": "{{model}}", "refId": "A"}],
      "title": "Input and output tokens by model",
      "type": "barchart"
