      "targets": [{"expr": "sum by (model) (increase(opencode_ai_requests_total[$__range]))", "legendFormat": "{{model}}", "refId": "A"}],
      "title": "Completed assistant messages by model",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "victoria-metrics"},
