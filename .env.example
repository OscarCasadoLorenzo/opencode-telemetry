OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.162.0
VICTORIA_METRICS_IMAGE=victoriametrics/victoria-metrics:v1.154.0
GRAFANA_IMAGE=grafana/grafana-oss:13.0.2

# Use the existing Docker network shared by Nginx Proxy Manager.
NPM_PROXY_NETWORK=replace-with-your-npm-network

# Choose a retention period that fits the NAS disk capacity.
VM_RETENTION_PERIOD=365d
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
